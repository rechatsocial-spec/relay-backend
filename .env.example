# PostgreSQL
DATABASE_URL=postgresql://relay_user:relay_pass@localhost:5432/relay_crm

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Google Sign-In — OAuth 2.0 *Web application* Client ID from Google Cloud Console
# (APIs & Services > Credentials). Leave empty to hide the Google button.
# Add http://localhost:5173 (and your prod URL) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# CORS — "*" is fine locally. Before deploying, set your frontend origin(s), e.g.
# CORS_ORIGINS=["https://app.yourdomain.com"]
CORS_ORIGINS=["*"]

# WhatsApp sending
# WHATSAPP_MOCK=true  -> nothing is really sent (safe default for development)
# WHATSAPP_MOCK=false + WHATSAPP_PROVIDER=twilio -> real WhatsApp messages via Twilio
WHATSAPP_MOCK=true
WHATSAPP_PROVIDER=twilio

# Wasender (WHATSAPP_PROVIDER=wasender) — session API key from wasenderapi.com.
# Use CAMPAIGN_SEND_INTERVAL_SECONDS of 5+ to protect your number from bans.
WASENDER_API_KEY=
WASENDER_BASE_URL=https://www.wasenderapi.com/api

# Twilio — Console home page (console.twilio.com). The Auth Token is a password:
# keep it only in this file, never commit it or paste it anywhere.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public https address of this backend, so Twilio can deliver incoming messages
# and delivered/read receipts (e.g. https://xxxx.trycloudflare.com or your Render URL).
# Sending works without it; replies and ticks need it.
PUBLIC_BASE_URL=

# Seconds between campaign messages. Sandbox allows ~1 per 3s. A registered
# WhatsApp sender can go much faster (e.g. 0.05).
CAMPAIGN_SEND_INTERVAL_SECONDS=3
