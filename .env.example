# PostgreSQL
DATABASE_URL=postgresql://relay_user:relay_pass@localhost:5432/relay_crm

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Google Sign-In — OAuth 2.0 *Web application* Client ID from Google Cloud Console
# (APIs & Services > Credentials). Leave empty to hide the Google button.
# Add http://localhost:5173 (and your prod URL) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# CORS — "*" is fine locally. Before deploying, set your frontend origin(s), e.g.
# CORS_ORIGINS=["https://app.yourdomain.com"]
CORS_ORIGINS=["*"]

# WhatsApp — Unipile v2 is the only provider (https://developer.unipile.com/v2.0/docs/)
# Live by default. Only on a developer machine: WHATSAPP_MOCK=true fakes sends (no network).
WHATSAPP_MOCK=false

# Service Key from Unipile dashboard > your Application > API Keys > Service Keys
# (shown once; keys expire — rotate before the date). Password: env only, never commit.
UNIPILE_API_KEY=
UNIPILE_BASE_URL=https://api.unipile.com/v2
# Signing secret of the webhook endpoint {PUBLIC_BASE_URL}/api/v1/unipile/webhook
UNIPILE_WEBHOOK_SECRET=

# Public https address of this backend (e.g. https://relay-backend.onrender.com).
PUBLIC_BASE_URL=

# Seconds between campaign messages. Keep 5+ to protect linked numbers from bans.
CAMPAIGN_SEND_INTERVAL_SECONDS=5

# Optional: creates this Super Admin on startup if it doesn't exist (production
# alternative to the demo seed, which uses a known password).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# The demo seed is removed automatically at startup. Developer machines only: KEEP_DEMO_DATA=true
# PURGE_KEEP_EMAILS=
# Only if the API key may not list accounts: UNIPILE_ACCOUNT_IDS=acc_1,acc_2
